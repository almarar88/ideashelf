# ---------------------------------------------------------------------------
# Alcode Trips backend configuration
#
# The server runs with none of these set: photos and exchange rates need no
# credentials. Prices need at least one partner.
# ---------------------------------------------------------------------------

PORT=8787
# Lock this to your app's origin in production; "*" is fine while developing.
ALLOWED_ORIGIN=*

# --- Amadeus Self-Service: real flights AND hotels ---------------------------
# Free key: https://developers.amadeus.com  ->  Self-Service  ->  My Apps
# The test host serves real (cached) fares on a limited set of routes.
# Switch AMADEUS_HOST to https://api.amadeus.com with a production key.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOST=https://test.api.amadeus.com

# --- Travelpayouts / Aviasales: real fares with a bookable affiliate link ----
# Free token: https://www.travelpayouts.com  ->  Tools  ->  API
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# --- Optional ----------------------------------------------------------------
# Wikimedia asks API clients to identify themselves with a contact address.
CONTACT_EMAIL=

# Serve photos through this server instead of hotlinking Wikimedia's CDN.
# Off by default: it costs you bandwidth and helps only on networks that
# block wikimedia.org.
PROXY_IMAGES=0

# Serve recorded fixtures when no partner is configured, so the UI can be
# developed without spending API quota. Everything it returns is labelled
# "development fixtures" in the app. Never enable this in production.
MOCK_PARTNERS=0
