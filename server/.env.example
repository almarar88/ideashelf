# ---- Required ----
# Your Anthropic API key (console.anthropic.com). Users never see it.
ANTHROPIC_API_KEY=sk-ant-...
# Supabase project (Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role key — server only, never ship in the app

# ---- Optional ----
PORT=8080
# RevenueCat → Project → API keys → secret key (v1). Lets the server verify entitlements on demand.
REVENUECAT_SECRET_KEY=sk_...
# RevenueCat → Integrations → Webhooks → Authorization header value you choose.
REVENUECAT_WEBHOOK_AUTH=some-long-random-string
# Entitlement identifiers configured in RevenueCat (default: liwabot_pro, liwabot_ultra)
RC_ENTITLEMENT_PRO=liwabot_pro
RC_ENTITLEMENT_ULTRA=liwabot_ultra
# Comma-separated list of user ids (or emails) that get 'ultra' for free (you, testers)
ADMIN_USERS=
# Max simultaneous streams per user
MAX_CONCURRENT=4
