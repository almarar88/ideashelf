    "@capacitor/status-bar": "^7.0.6",
    "docx": "^9.7.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "xlsx": "^0.18.5",
