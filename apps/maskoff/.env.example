# ---------------------------------------------------------------------------
# MaskOff AI — environment
# ---------------------------------------------------------------------------
# Backend adapter: "local" (offline simulator, no server needed) | "supabase"
VITE_BACKEND=local

# Supabase (only needed when VITE_BACKEND=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI transport.
#  - "edge"   (DEFAULT, required for production): calls Supabase Edge Functions.
#             The Gemini key lives ONLY on the server. See supabase/functions/.
#  - "direct" (LOCAL DEV ONLY): calls Gemini from the browser with the key
#             below. Never ship this — a client-side key is a public key.
#  - "off"    : never call the network, always use the offline fallback bank.
VITE_AI_TRANSPORT=off
VITE_GEMINI_MODEL=gemini-1.5-flash

# DEV ONLY. Do not set this in any deployed build.
VITE_DEV_GEMINI_API_KEY=
