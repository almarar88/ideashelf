{
  "name": "maskoff-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit false --pretty false",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "test": "node --test --experimental-strip-types --import ./tests/alias-loader-register.mjs tests/*.test.ts",
    "test:e2e": "node tests/walkthrough.mjs ./tests/screenshots",
    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:open": "npx cap open android",
    "icons": "node gen-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.16",
    "typescript": "~5.6.2",
    "vite": "^6.0.1"
  }
}
